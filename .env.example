# Docker Compose quick start: cp .env.example .env && docker compose up -d --build
# Must exactly match the URL used by the browser (scheme, hostname, and port).
MEMORY_PUBLIC_ORIGIN=http://localhost:8080
MEMORY_BIND_ADDRESS=127.0.0.1
MEMORY_HTTP_PORT=8080
MEMORY_SIGNUP_ENABLED=true
# JSON array of browser-login emails allowed to use /admin. API/agent keys never qualify.
MEMORY_ADMIN_EMAILS=[]
MEMORY_UPLOAD_MAX_BYTES=104857600

# PostgreSQL 17 + pgvector. Replace the password before exposing the service.
POSTGRES_DB=vibe_memory
POSTGRES_USER=vibe_memory
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional legacy agent keys for source installs; console-created keys need no env changes.
MEMORY_API_KEYS={}
# Source-install storage and server defaults (Compose stores them under /data instead).
MEMORY_DATA_DIR=.data
# Source installations require PostgreSQL. Compose sets this automatically.
# MEMORY_DATABASE_URL=postgresql://vibe_memory:password@127.0.0.1:5432/vibe_memory
MEMORY_DATABASE_POOL_SIZE=10
MEMORY_EMBEDDING_DIMENSION=384
# Optional path to a persistent 32-byte Vault key file. The server creates it when absent.
# MEMORY_VAULT_KEY_FILE=/secure/persistent/vault.key
MEMORY_EMBEDDING_CACHE=.data/models
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8080

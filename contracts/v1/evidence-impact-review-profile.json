{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/evidence-impact-review-profile.json",
  "title": "Vibe Memory Evidence Impact Review Profile 1",
  "description": "One optional agent-supplied observation about the impact of an exact evidence record version. Shape conformance does not prove impact, authority, or truth. Conflicting observations remain separate records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "target", "evidence", "reviewer", "observed_at", "impact", "rationale"],
  "properties": {
    "type": {"const": "evidence_impact_review"},
    "version": {"const": 1},
    "target": {"$ref": "#/$defs/target"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 300},
    "observed_at": {"type": "string", "format": "date-time"},
    "impact": {"enum": ["affected", "not_affected", "unknown"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "follow_up": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["record", "relation"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "version"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "integer", "minimum": 1},
        "source_type": {"enum": ["git_commit", "requirements_revision", "document_revision", "web", "other"]},
        "permalink": {"type": "string", "minLength": 1, "maxLength": 2000},
        "revision": {"type": "string", "minLength": 1, "maxLength": 300},
        "commit_sha": {"type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-fA-F]+$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

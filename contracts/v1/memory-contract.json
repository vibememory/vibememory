{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/memory-contract.json",
  "title": "Vibe Memory Contract 1.1",
  "description": "Interoperability contract for agent-authored memory data. The server performs no LLM inference.",
  "type": "object",
  "required": ["id", "kind", "keywords", "version", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["memory", "document", "entity", "file"]},
    "content": {"type": "string"},
    "title": {"type": "string"},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time", "description": "Server-recorded UTC time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time", "description": "Agent-supplied UTC valid time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time", "description": "Exclusive agent-supplied UTC valid-time end; not deletion"},
    "creator_agent_id": {"type": "string"},
    "provenance": {"type": "object"},
    "correction_status": {"enum": ["current", "superseded", "conflict", "cycle", "unresolved"]}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/skill-execution-profile.json",
  "title": "Vibe Memory Skill Execution Profile 1",
  "description": "Optional observation of a Skill execution performed by an external harness. The service stores and exchanges the report but never downloads or runs the Skill, executes a stored command, verifies the reported harness, or grants execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "skill", "reported_harness", "started_at", "reported_status", "verification_status"],
  "properties": {
    "type": {"const": "skill_execution"},
    "version": {"const": 1},
    "skill": {"$ref": "#/$defs/skill"},
    "reported_harness": {"$ref": "#/$defs/harness"},
    "reported_agent": {"type": "string", "minLength": 1, "maxLength": 300},
    "task_ref": {"$ref": "#/$defs/evidence"},
    "environment_ref": {"$ref": "#/$defs/evidence"},
    "input_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "reported_status": {"enum": ["started", "succeeded", "failed", "cancelled", "unknown"]},
    "evidence_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
    "artifact_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
    "failure_reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "verification_status": {"enum": ["unverified", "author_reported", "observed", "reproduced", "unavailable"]}
  },
  "allOf": [
    {
      "if": {"properties": {"reported_status": {"const": "failed"}}, "required": ["reported_status"]},
      "then": {"required": ["finished_at", "failure_reason"]}
    },
    {
      "if": {"properties": {"reported_status": {"enum": ["succeeded", "cancelled", "unknown"]}}, "required": ["reported_status"]},
      "then": {"required": ["finished_at"]}
    }
  ],
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300},
        "digest": {"type": "string", "maxLength": 71, "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
      },
      "anyOf": [{"required": ["version"]}, {"required": ["digest"]}]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "version"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "integer", "minimum": 1},
        "source_type": {"enum": ["git_commit", "requirements_revision", "document_revision", "web", "other"]},
        "permalink": {"type": "string", "minLength": 1, "maxLength": 2000},
        "revision": {"type": "string", "minLength": 1, "maxLength": 300},
        "commit_sha": {"type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-fA-F]+$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

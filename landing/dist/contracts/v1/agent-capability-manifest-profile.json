{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/agent-capability-manifest-profile.json",
  "title": "Vibe Memory Agent Capability Manifest Profile 1",
  "description": "A versioned declaration supplied by an external agent or harness. It is not an effective Vibe Memory permission grant, availability probe, assignment request, or success guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "manifest_version", "agent_id", "harness", "capabilities", "observed_at"],
  "properties": {
    "type": {"const": "agent_capability_manifest"},
    "version": {"const": 1},
    "manifest_version": {"type": "integer", "minimum": 1},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "harness": {"$ref": "#/$defs/harness"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "skill_refs": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/skill"}},
    "supported_task_types": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "required_permissions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/permission"}},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z][a-z0-9._-]*$"},
    "permission": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z][a-z0-9._:-]*$"},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300},
        "digest": {"type": "string", "maxLength": 71, "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
      },
      "anyOf": [{"required": ["version"]}, {"required": ["digest"]}]
    }
  }
}

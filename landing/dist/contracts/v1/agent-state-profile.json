{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/agent-state-profile.json",
  "title": "Vibe Memory Agent State Profile 1",
  "description": "Optional harness-neutral task state supplied by an agent. The record envelope version is the optimistic concurrency coordinate. Profile conformance does not prove completion, authority, or successful execution, and the service never schedules or executes next actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "project_id", "task_id", "state_version", "status", "goal", "reported_harness", "observed_at"],
  "properties": {
    "type": {"const": "agent_state"},
    "version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "state_version": {"type": "integer", "minimum": 1, "description": "Agent-supplied payload revision. The enclosing record version remains authoritative for expected_version conflict detection."},
    "status": {"enum": ["unknown", "planned", "in_progress", "blocked", "completed", "cancelled"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "completed": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "next_actions": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "blockers": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "decision_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
    "evidence_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
    "skill_refs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/skill"}},
    "reported_harness": {"$ref": "#/$defs/harness"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 300},
        "digest": {"type": "string", "maxLength": 71, "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
      },
      "anyOf": [{"required": ["version"]}, {"required": ["digest"]}]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "version"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "integer", "minimum": 1},
        "source_type": {"enum": ["git_commit", "requirements_revision", "document_revision", "web", "other"]},
        "permalink": {"type": "string", "minLength": 1, "maxLength": 2000},
        "revision": {"type": "string", "minLength": 1, "maxLength": 300},
        "commit_sha": {"type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-fA-F]+$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

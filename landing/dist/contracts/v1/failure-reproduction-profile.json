{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/failure-reproduction-profile.json",
  "title": "Vibe Memory Failure Reproduction Profile 1",
  "description": "Optional agent-supplied failure reproduction evidence. Shape conformance does not prove the failure, verification result, authority, or safety. Vibe Memory never opens external references, executes commands, or collects raw logs; clients inspect authorized evidence and report sanitized observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "outcome", "observed_at", "sample", "failure", "minimal_reproduction"],
  "properties": {
    "type": {"const": "failure_reproduction"},
    "version": {"const": 1},
    "outcome": {"enum": ["failed", "invalid_result"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "sample": {"$ref": "#/$defs/sample"},
    "attempted_settings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/setting"}},
    "failure": {"$ref": "#/$defs/failure"},
    "minimal_reproduction": {"$ref": "#/$defs/minimal_reproduction"},
    "parsing_steps": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/parsing_step"}},
    "evidence_references": {"type": "array", "maxItems": 50, "items": {"oneOf": [{"$ref": "#/$defs/uploaded_file"}, {"$ref": "#/$defs/external"}]}}
  },
  "$defs": {
    "short_text": {"type": "string", "minLength": 1, "maxLength": 300},
    "long_text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier"],
      "properties": {
        "identifier": {"$ref": "#/$defs/short_text"},
        "record_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "record_version": {"type": "integer", "minimum": 1},
        "input_rows": {"type": "integer", "minimum": 0},
        "input_bytes": {"type": "integer", "minimum": 0},
        "description": {"$ref": "#/$defs/long_text"},
        "input_excerpt_redacted": {"$ref": "#/$defs/long_text"}
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_redacted"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100, "description": "A non-sensitive setting name; runtime validation rejects credential, password, secret, token, cookie, authorization, and API-key names."},
        "value_redacted": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message_redacted"],
      "properties": {
        "stage": {"$ref": "#/$defs/short_text"},
        "code": {"$ref": "#/$defs/short_text"},
        "message_redacted": {"$ref": "#/$defs/long_text"}
      }
    },
    "minimal_reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "observed_result"],
      "properties": {
        "conditions": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/long_text"}},
        "command": {"$ref": "#/$defs/long_text"},
        "expected_result": {"$ref": "#/$defs/long_text"},
        "observed_result": {"$ref": "#/$defs/long_text"}
      }
    },
    "parsing_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "stage", "operation", "input_summary", "output_summary"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 1000},
        "stage": {"$ref": "#/$defs/short_text"},
        "operation": {"$ref": "#/$defs/short_text"},
        "input_summary": {"$ref": "#/$defs/long_text"},
        "output_summary": {"$ref": "#/$defs/long_text"}
      }
    },
    "uploaded_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_id"],
      "properties": {
        "kind": {"const": "uploaded_file"},
        "file_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "file_version": {"type": "integer", "minimum": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["match", "changed", "missing", "inaccessible", "unverified"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "observed_sha256": {"$ref": "#/$defs/sha256"},
        "observed_bytes": {"type": "integer", "minimum": 0},
        "detail_redacted": {"$ref": "#/$defs/long_text"}
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"const": "external"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 2000},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_bytes": {"type": "integer", "minimum": 0},
        "verification": {"$ref": "#/$defs/verification"}
      }
    }
  }
}

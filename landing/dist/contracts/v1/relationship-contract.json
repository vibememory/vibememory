{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibememory.io/contracts/v1/relationship-contract.json",
  "title": "Vibe Memory Relationship Contract 1.1",
  "description": "A versioned relationship inferred and supplied by an authenticated agent.",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "target_id",
    "relation",
    "reason",
    "status",
    "version",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "relation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "reason": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "retracted"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-recorded UTC time"
    },
    "creator_agent_id": {"type": "string"},
    "creator_agent_name": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_coverage": {"enum": ["selected", "partial", "unknown"]},
    "extraction_method": {"type": "string"},
    "extraction_version": {"type": "string"},
    "correction_scope": {"enum": ["unknown", "full", "partial"]},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}

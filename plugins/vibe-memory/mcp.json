{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vibe-memory": {
      "type": "streamable-http",
      "url": "https://vibememory.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "memory:read"
            ],
            "defaultScopes": [
              "memory:read",
              "memory:write",
              "feature:write"
            ]
          }
        }
      }
    }
  }
}
